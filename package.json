{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/jp-font.mjs --check && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "messages:check": "node scripts/check-messages.mjs",
    "html:check": "html-validate \".next/server/app/**/*.html\"",
    "fonts:jp": "node scripts/jp-font.mjs",
    "images:hero": "node scripts/hero-emblem.mjs",
    "format": "prettier --write src messages scripts \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check src messages scripts \"*.{ts,mjs,json}\"",
    "perf:check": "node scripts/perf-check.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "^16.38.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "html-validate": "^11.21.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.24.0"
}
